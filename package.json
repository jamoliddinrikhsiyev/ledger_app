{
  "name": "ledger",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/copy-wasm.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "verify:sql": "node --experimental-sqlite scripts/verify-sql.mjs",
    "verify:rates": "node --experimental-strip-types scripts/verify-rates.mjs",
    "verify": "npm run typecheck && npm run verify:sql && npm run verify:rates",
    "drive": "node scripts/drive-app.mjs",
    "sync": "npm run build && cap sync",
    "ios": "npm run sync && cap open ios",
    "android": "npm run sync && cap open android"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/inter": "^5.3.0",
    "@ionic/react": "^8.8.17",
    "@ionic/react-router": "^8.8.17",
    "@phosphor-icons/web": "^2.1.2",
    "ionicons": "^8.1.0",
    "jeep-sqlite": "^2.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router": "^5.1.20",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "sql.js": "1.12.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
